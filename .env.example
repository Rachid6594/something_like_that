# Set these in Render's Environment panel, not in GitHub.
# This file is documentation; Node does not load it automatically.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional recipient, international digits only:
MY_NUMBER=
# Local port; Render supplies PORT automatically.
PORT=3000
# Render supplies RENDER_EXTERNAL_URL; PUBLIC_ORIGIN is optional for custom domains.
# PUBLIC_ORIGIN=https://your-service.onrender.com
# Optional storage directory for a future persistent disk:
# DATA_DIR=/var/data
